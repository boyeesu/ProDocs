{
  "name": "prodocs",
  "version": "0.2.0",
  "description": "Evidence-backed documentation and context infrastructure for codebases and coding agents.",
  "type": "module",
  "author": "ProDocs contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyeesu/prodocs.git"
  },
  "homepage": "https://github.com/boyeesu/prodocs#readme",
  "bugs": {
    "url": "https://github.com/boyeesu/prodocs/issues"
  },
  "bin": {
    "prodocs": "bin/prodocs.js"
  },
  "exports": {
    "./collectors": "./src/collectors/index.js",
    "./schemas/collector-result.schema.json": "./schemas/collector-result.schema.json"
  },
  "files": [
    "bin",
    "fixtures",
    "scripts",
    "src",
    "schemas",
    "docs/COLLECTORS.md",
    "docs/COMPATIBILITY.md",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/prodocs.js",
    "test": "node --test",
    "test:coverage": "node ./scripts/coverage.js",
    "lint": "node ./scripts/lint.js",
    "docs:sync": "node ./bin/prodocs.js sync",
    "docs:check": "node ./bin/prodocs.js check",
    "release:check": "node ./scripts/verify-release.js",
    "verify": "npm run lint && npm test && npm run release:check && npm run docs:check",
    "verify:production": "npm run verify && npm run test:coverage && npm audit --omit=dev && npm audit signatures && npm pack --dry-run",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "documentation",
    "codebase",
    "agents",
    "codex",
    "claude-code",
    "opencode",
    "knowledge-graph"
  ],
  "dependencies": {
    "@babel/parser": "7.28.5"
  }
}
