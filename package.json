{
  "name": "@danielesuga/prodocs",
  "version": "1.2.1",
  "description": "Evidence-backed documentation and context infrastructure for codebases and coding agents.",
  "type": "module",
  "author": "ProDocs contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyeesu/prodocs.git"
  },
  "homepage": "https://github.com/boyeesu/prodocs#readme",
  "bugs": {
    "url": "https://github.com/boyeesu/prodocs/issues"
  },
  "bin": {
    "prodocs": "bin/prodocs.js"
  },
  "exports": {
    "./adoption": "./src/adoption.js",
    "./collectors": "./src/collectors/index.js",
    "./plugins": "./src/plugins.js",
    "./providers": "./src/providers.js",
    "./schemas/adoption-proposal.schema.json": "./schemas/adoption-proposal.schema.json",
    "./schemas/collector-result.schema.json": "./schemas/collector-result.schema.json",
    "./schemas/context-packet.schema.json": "./schemas/context-packet.schema.json",
    "./schemas/impact.schema.json": "./schemas/impact.schema.json",
    "./schemas/knowledge.schema.json": "./schemas/knowledge.schema.json",
    "./schemas/proposal.schema.json": "./schemas/proposal.schema.json"
  },
  "files": [
    "bin",
    "fixtures",
    "scripts",
    "src",
    "schemas",
    "docs",
    "examples",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/prodocs.js",
    "test": "node --test",
    "test:coverage": "node ./scripts/coverage.js",
    "lint": "node ./scripts/lint.js",
    "docs:sync": "node ./bin/prodocs.js sync",
    "docs:check": "node ./bin/prodocs.js check",
    "release:check": "node ./scripts/verify-release.js",
    "quality:check": "node ./bin/prodocs.js policy && node ./bin/prodocs.js evaluate --suite fixtures/evaluation/core.json && node ./bin/prodocs.js evaluate --suite fixtures/evaluation/agents.json && node ./bin/prodocs.js plugin verify fixtures/plugins/service.prodocs-plugin.json",
    "complexity:check": "node ./scripts/complexity.js",
    "benchmark": "node ./bin/prodocs.js benchmark --suite fixtures/evaluation/agents.json --json",
    "test:mutation": "stryker run",
    "verify": "npm run lint && npm run complexity:check && npm test && npm run release:check && npm run docs:check && npm run quality:check",
    "verify:production": "npm run verify && npm run test:coverage && npm audit --omit=dev && npm audit signatures && npm pack --dry-run",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "documentation",
    "codebase",
    "agents",
    "codex",
    "claude-code",
    "opencode",
    "knowledge-graph"
  ],
  "dependencies": {
    "@babel/parser": "7.28.5",
    "sql.js": "1.14.1",
    "yaml": "2.9.0"
  },
  "overrides": {
    "qs": "6.15.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0"
  }
}
