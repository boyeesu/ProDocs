{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/boyeesu/prodocs/main/schemas/context-packet.schema.json",
  "title": "ProDocs context packet",
  "description": "A deterministic, evidence-backed dependency neighborhood for humans and coding agents.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "root",
    "sourceHash",
    "inputHash",
    "request",
    "freshness",
    "stats",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "prodocs.context-packet"
    },
    "root": {
      "const": "."
    },
    "sourceHash": {
      "$ref": "#/$defs/hash"
    },
    "inputHash": {
      "$ref": "#/$defs/hash"
    },
    "request": {
      "type": "object",
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": [
        "status",
        "documentedSourceHash",
        "documentedInputHash"
      ],
      "properties": {
        "status": {
          "enum": [
            "fresh",
            "stale",
            "missing"
          ]
        },
        "documentedSourceHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "documentedInputHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "required": [
        "files",
        "symbols",
        "relationships",
        "contextBytes",
        "estimatedTokens"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "symbols": {
          "type": "integer",
          "minimum": 0
        },
        "relationships": {
          "type": "integer",
          "minimum": 0
        },
        "contextBytes": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "symbol": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "line"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "reason",
        "matchedPaths",
        "relatedTo"
      ],
      "properties": {
        "reason": {
          "enum": [
            "requested",
            "dependency"
          ]
        },
        "matchedPaths": {
          "$ref": "#/$defs/stringSet"
        },
        "relatedTo": {
          "$ref": "#/$defs/stringSet"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "requested"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "matchedPaths": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "dependency"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "relatedTo": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "path",
        "language",
        "contentHash",
        "lines",
        "owner",
        "entrypoint",
        "symbols",
        "selection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^file:.+"
        },
        "type": {
          "const": "file"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "language": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "entrypoint": {
          "type": "boolean"
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "type",
        "from",
        "to",
        "evidence"
      ],
      "properties": {
        "type": {
          "const": "imports"
        },
        "from": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "to": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "object",
          "required": [
            "source",
            "specifier"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "specifier": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
