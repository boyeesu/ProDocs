{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/boyeesu/prodocs/main/schemas/context-packet.schema.json",
  "title": "ProDocs bounded context packet",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "root",
    "sourceHash",
    "knowledgeHash",
    "inputHash",
    "request",
    "freshness",
    "stats",
    "security",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "prodocs.context-packet" },
    "root": { "const": "." },
    "sourceHash": { "$ref": "#/$defs/hash" },
    "knowledgeHash": { "$ref": "#/$defs/hash" },
    "inputHash": { "$ref": "#/$defs/hash" },
    "request": {
      "type": "object",
      "required": ["paths", "task", "budget"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "task": { "type": ["string", "null"], "maxLength": 2048 },
        "budget": {
          "type": "object",
          "required": [
            "maxFiles",
            "maxTokens",
            "truncated",
            "omittedNodes"
          ],
          "properties": {
            "maxFiles": { "type": "integer", "minimum": 1 },
            "maxTokens": { "type": "integer", "minimum": 128 },
            "truncated": { "type": "boolean" },
            "omittedNodes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": [
        "status",
        "documentedSourceHash",
        "documentedKnowledgeHash",
        "documentedInputHash"
      ],
      "properties": {
        "status": { "enum": ["fresh", "stale", "missing"] },
        "documentedSourceHash": { "$ref": "#/$defs/nullableHash" },
        "documentedKnowledgeHash": { "$ref": "#/$defs/nullableHash" },
        "documentedInputHash": { "$ref": "#/$defs/nullableHash" }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "required": [
        "files",
        "knowledge",
        "symbols",
        "relationships",
        "totalCandidates",
        "omittedNodes",
        "contextBytes",
        "estimatedTokens"
      ],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "knowledge": { "type": "integer", "minimum": 0 },
        "symbols": { "type": "integer", "minimum": 0 },
        "relationships": { "type": "integer", "minimum": 0 },
        "totalCandidates": { "type": "integer", "minimum": 0 },
        "omittedNodes": { "type": "integer", "minimum": 0 },
        "contextBytes": { "type": "integer", "minimum": 0 },
        "estimatedTokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "repositoryContent",
        "instructionPolicy",
        "flaggedPaths"
      ],
      "properties": {
        "repositoryContent": { "const": "untrusted" },
        "instructionPolicy": { "type": "string", "minLength": 1 },
        "flaggedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "selection"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "selection": {
            "type": "object",
            "required": ["reason", "matchedPaths", "relatedTo"],
            "properties": {
              "reason": { "enum": ["requested", "dependency"] },
              "matchedPaths": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string" }
              },
              "relatedTo": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to", "evidence"],
        "properties": {
          "type": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "evidence": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
