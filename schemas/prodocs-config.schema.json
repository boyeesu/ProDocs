{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/boyeesu/prodocs/main/schemas/prodocs-config.schema.json",
  "title": "ProDocs configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "output",
    "include",
    "exclude",
    "entrypoints",
    "ownership",
    "limits",
    "knowledge",
    "index",
    "plugins",
    "policies",
    "documentation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxFiles",
        "maxFileSizeBytes",
        "maxTotalBytes"
        ,"maxContextFiles"
        ,"maxContextTokens"
        ,"maxProviderBytes"
      ],
      "properties": {
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxFileSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "maxContextFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxContextTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxProviderBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        }
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "required": ["paths", "requireEvidence"],
      "properties": {
        "paths": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1 }
        },
        "requireEvidence": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "required": ["enabled", "path"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "required": [
        "publicSurfaceRequiresOwner",
        "publicSurfaceRequiresClaim",
        "claimRequiresEvidence",
        "runbookRequiresVerification"
      ],
      "properties": {
        "publicSurfaceRequiresOwner": { "type": "boolean" },
        "publicSurfaceRequiresClaim": { "type": "boolean" },
        "claimRequiresEvidence": { "type": "boolean" },
        "runbookRequiresVerification": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": [
        "productName",
        "oneLineDescription",
        "audiences"
      ],
      "properties": {
        "productName": {
          "type": "string"
        },
        "oneLineDescription": {
          "type": "string"
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
